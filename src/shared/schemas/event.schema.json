{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpgmaker.local/schemas/event.schema.json",
  "title": "MapEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "mapId", "x", "y", "pages"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "mapId": { "type": "string", "minLength": 1 },
    "x": { "type": "integer", "minimum": 0 },
    "y": { "type": "integer", "minimum": 0 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commands"],
        "properties": {
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": ["message", "choice", "setSwitch", "setVariable", "condition", "loop", "transfer", "move", "battle", "item", "gold", "wait", "audio", "picture", "plugin"]
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
